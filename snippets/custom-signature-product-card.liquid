{% doc %}
Renders a Diamondrensu signature collection product card.
@param {product} product - The Shopify product object
@param {string} [badge_text] - Optional badge label
@param {string} [overlay_text] - Optional image overlay label
@param {string} [default_asset] - Figma default theme asset when product has no image
@example
{% render 'custom-signature-product-card', product: product, badge_text: 'Best Seller' %}
{% enddoc %}

{%- liquid
  assign card_image = product.featured_media
  assign compare_at = product.compare_at_price
  assign price = product.price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
    assign discount = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round
  endif
-%}

<article class="custom-signature-card">
  <a href="{{ product.url }}" class="custom-signature-card__link">
    <div class="custom-signature-card__media">
      <div class="custom-signature-card__media-frame">
        {%- if card_image != blank -%}
          {{
            card_image
            | image_url: width: 500
            | image_tag:
              loading: 'lazy',
              alt: product.title,
              class: 'custom-signature-card__image',
              widths: '248, 350, 496',
              height: 248,
              width: 248
          }}
        {%- else -%}
          {% render 'custom-theme-image',
            default_asset: default_asset,
            alt: product.title,
            class: 'custom-signature-card__image',
            width: 248,
            height: 248,
            placeholder_class: 'custom-signature-card__placeholder'
          %}
        {%- endif -%}

        {%- if overlay_text != blank -%}
          <span class="custom-signature-card__overlay">{{ overlay_text | escape }}</span>
        {%- endif -%}

        {%- if badge_text != blank -%}
          <span class="custom-signature-card__badge">{{ badge_text | escape }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="custom-signature-card__info">
      <h3 class="custom-signature-card__title">{{ product.title | escape }}</h3>

      <div class="custom-signature-card__price-row">
        <span class="custom-signature-card__price">{% render 'price', product: product, price_class: 'custom-signature-card__price-text' %}</span>
        {%- if on_sale -%}
          <span class="custom-signature-card__discount">{{ discount }}% off</span>
        {%- endif -%}
      </div>
    </div>
  </a>
</article>
