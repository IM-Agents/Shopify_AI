{%- comment -%}
  Snippet: custom-product-badge.liquid
  Renders a badge on product cards (Sale, New, Sold Out, etc.)

  USAGE:
    {% render 'custom-product-badge', product: product %}

  PARAMETERS:
    - product {Object} required — the Shopify product object

  CUSTOM FILE — Safe to modify freely.
{%- endcomment -%}

{%- liquid
  assign badge_label = ''
  assign badge_class = ''

  assign created_at = product.created_at | date: '%s' | plus: 0
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign age_seconds = now_timestamp | minus: created_at

  if product.available == false
    assign badge_label = 'products.product.sold_out' | t
    assign badge_class = 'custom-badge--sold-out'
  elsif product.compare_at_price > product.price
    assign badge_label = 'products.product.on_sale' | t
    assign badge_class = 'custom-badge--sale'
  elsif age_seconds < 2592000
    assign badge_label = 'custom.badges.new' | t
    assign badge_class = 'custom-badge--new'
  endif
-%}

{%- if badge_label != blank -%}
  <span class="custom-badge {{ badge_class }}" aria-label="{{ badge_label }}">
    {{- badge_label -}}
  </span>
{%- endif -%}
