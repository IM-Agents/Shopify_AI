{% doc %}
  Renders a navigation list from a Shopify menu (linklist). Supports one level of
  dropdown via `link.links`. All labels and URLs come from the merchant's menu —
  nothing is hardcoded.

  @param {linklist} menu - The menu object, e.g. linklists[section.settings.menu]
  @param {string} [list_class] - Class applied to the root <ul>

  Security note: link.url / child.url come from a Shopify menu (linklist), which the
  platform constrains to valid URLs. Titles are escaped. Do NOT swap these href
  sources to a free-text setting/metafield without adding URL validation.

  @example
  {% render 'custom-header-menu', menu: linklists['main-menu'], list_class: 'custom-header__menu' %}
{% enddoc %}
{%- liquid
  assign root_class = list_class | default: 'custom-header__menu'
-%}
{%- if menu != blank and menu.links.size > 0 -%}
  <ul class="{{ root_class }}" role="list">
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <li class="custom-header__item custom-header__item--has-children">
          <details class="custom-header__dropdown">
            <summary class="custom-header__link custom-header__summary">
              <span>{{ link.title | escape }}</span>
              {% render 'custom-icon', icon: 'chevron', class: 'custom-header__chevron' %}
            </summary>
            <ul class="custom-header__submenu" role="list">
              {%- for child in link.links -%}
                <li class="custom-header__subitem">
                  <a
                    class="custom-header__sublink{% if child.current %} is-active{% endif %}"
                    href="{{ child.url }}"
                    {% if child.current %}aria-current="page"{% endif %}
                  >{{ child.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </details>
        </li>
      {%- else -%}
        <li class="custom-header__item">
          <a
            class="custom-header__link{% if link.current %} is-active{% endif %}"
            href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}
          >{{ link.title | escape }}</a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
