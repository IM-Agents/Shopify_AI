{% doc %}
Renders an image: theme editor picker → Figma default asset → Shopify placeholder skeleton.
@param {image} [image] - image_picker setting value (upload via theme editor)
@param {string} [default_asset] - Figma-exported theme asset filename
@param {string} alt - Accessible alt text
@param {string} class - CSS class for the image or placeholder wrapper
@param {number} [width] - Display width attribute
@param {number} [height] - Display height attribute
@param {number} [image_width] - CDN resize width for picker images
@param {string} [widths] - Responsive widths for picker images
@param {string} [sizes] - Responsive sizes attribute for picker images
@param {string} [loading] - lazy or eager
@param {boolean} [priority] - Set fetchpriority high for LCP images
@param {string} [placeholder] - placeholder_svg_tag name when no image or asset
@param {string} [placeholder_class] - Wrapper class for placeholder state
@example
{% render 'custom-theme-image', image: section.settings.image, default_asset: 'custom-hero-summer.png', alt: '', class: 'custom-dr-hero__image' %}
{% enddoc %}

{%- liquid
  assign picker_width = image_width | default: 600
  assign loading_mode = loading | default: 'lazy'
  assign placeholder_name = placeholder | default: 'product-1'
  assign placeholder_wrapper_class = placeholder_class | default: class | append: '-placeholder'
-%}

{%- if image != blank -%}
  {%- capture picker_image -%}
    {{
      image
      | image_url: width: picker_width
      | image_tag:
        loading: loading_mode,
        alt: alt,
        class: class,
        widths: widths,
        sizes: sizes,
        width: width,
        height: height
    }}
  {%- endcapture -%}
  {%- if priority -%}
    {{ picker_image | replace: '<img ', '<img fetchpriority="high" ' }}
  {%- else -%}
    {{ picker_image }}
  {%- endif -%}
{%- elsif default_asset != blank -%}
  <img
    src="{{ default_asset | asset_url }}"
    alt="{{ alt | escape }}"
    class="{{ class }}"
    loading="{{ loading_mode }}"
    {% if priority %}fetchpriority="high"{% endif %}
    {% if width %}width="{{ width }}"{% endif %}
    {% if height %}height="{{ height }}"{% endif %}
  >
{%- else -%}
  <div class="{{ placeholder_wrapper_class }}">
    {{ placeholder_name | placeholder_svg_tag }}
  </div>
{%- endif -%}
