{% doc %}
Renders a styled link or button.
@param {string} label - Button label text
@param {string} [url] - Destination URL
@param {string} [style] - Button style: primary, secondary, link
@param {string} [class] - Additional CSS classes
@param {boolean} [disabled] - Disable the button
@example
{% render 'custom-button', label: 'Shop now', url: '/collections/all', style: 'primary' %}
{% enddoc %}

{%- liquid
  assign button_style = style | default: 'primary'
  assign button_class = 'custom-button custom-button--' | append: button_style
  if class != blank
    assign button_class = button_class | append: ' ' | append: class
  endif
-%}

{%- if url != blank and disabled != true -%}
  <a href="{{ url }}" class="{{ button_class }}">
    {{- label | escape -}}
  </a>
{%- else -%}
  <span class="{{ button_class }}{% if disabled %} custom-button--disabled{% endif %}"{% if disabled %} aria-disabled="true"{% endif %}>
    {{- label | escape -}}
  </span>
{%- endif -%}
