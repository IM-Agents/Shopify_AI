{% doc %}
Returns the theme asset filename for a Figma-exported default image.
Synced from Figma file P3sdv4yrQT2RfucFvxYpEf, node 1:919 (Section 1).
@param {string} [key] - Named asset key
@param {string} [group] - Asset group: collection-product, ring-style, design-process
@param {number} [index] - 1-based index within group
@example
{% capture asset_name %}{% render 'custom-figma-asset', key: 'hero-summer' %}{% endcapture %}
{% enddoc %}

{%- liquid
  assign figma_asset = blank

  if key != blank
    case key
      when 'hero-summer'
        assign figma_asset = 'custom-hero-summer.png'
      when 'design-hero'
        assign figma_asset = 'custom-design-hero-4196a4.png'
      when 'ring-nature-inspired'
        assign figma_asset = 'custom-ring-nature-inspired-203fb6.png'
      when 'ring-solitaire'
        assign figma_asset = 'custom-ring-solitaire-203fb6.png'
      when 'ring-halo'
        assign figma_asset = 'custom-ring-halo-203fb6.png'
      when 'ring-three-stone'
        assign figma_asset = 'custom-ring-three-stone-203fb6.png'
      when 'ring-pave'
        assign figma_asset = 'custom-ring-pave-203fb6.png'
      when 'ring-vintage'
        assign figma_asset = 'custom-ring-vintage-203fb6.png'
    endcase
  endif

  if figma_asset == blank and group == 'collection-product' and index != blank
    case index
      when 1
        assign figma_asset = 'custom-product-1-56586a.png'
      when 2
        assign figma_asset = 'custom-product-2-56586a.png'
      when 3
        assign figma_asset = 'custom-product-3-56586a.png'
      when 4
        assign figma_asset = 'custom-product-4-56586a.png'
      when 5
        assign figma_asset = 'custom-product-5-56586a.png'
      when 6
        assign figma_asset = 'custom-product-6-56586a.png'
      when 7
        assign figma_asset = 'custom-product-7-56586a.png'
      when 8
        assign figma_asset = 'custom-product-8-56586a.png'
    endcase
  endif

  if figma_asset == blank and group == 'design-process' and index != blank
    assign figma_asset = 'custom-design-process-' | append: index | append: '-1c3792.png'
  endif
-%}{{- figma_asset -}}
