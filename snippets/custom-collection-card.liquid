{% doc %}
Renders a Diamondrensu collection page product card (Figma node 1:2 grid).
@param {product} product - The Shopify product object
@param {image} [image] - Optional image_picker override from theme editor
@param {string} [default_asset] - Figma default theme asset when product has no image
@example
{% render 'custom-collection-card', product: product, default_asset: 'custom-product-1-56586a.png' %}
{% enddoc %}

{%- liquid
  assign card_image = product.featured_media
  assign compare_at = product.compare_at_price
  assign price = product.price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
-%}

<article class="custom-collection-card">
  <a href="{{ product.url }}" class="custom-collection-card__link">
    <div class="custom-collection-card__media">
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 500
          | image_tag:
            loading: 'lazy',
            alt: product.title,
            class: 'custom-collection-card__image',
            widths: '212, 424, 636',
            width: 212,
            height: 212
        }}
      {%- else -%}
        {% render 'custom-theme-image',
          image: image,
          default_asset: default_asset,
          alt: product.title,
          class: 'custom-collection-card__image',
          width: 212,
          height: 212,
          image_width: 424,
          placeholder_class: 'custom-collection-card__placeholder'
        %}
      {%- endif -%}
    </div>

    <div class="custom-collection-card__info">
      <h3 class="custom-collection-card__title">{{ product.title | escape }}</h3>
      <div class="custom-collection-card__prices">
        {%- if on_sale -%}
          <span class="custom-collection-card__compare">{{ compare_at | money }}</span>
          <span class="custom-collection-card__price">{{ price | money }}</span>
        {%- else -%}
          <span class="custom-collection-card__price custom-collection-card__price--solo">{{ price | money }}</span>
        {%- endif -%}
      </div>
    </div>
  </a>
</article>
