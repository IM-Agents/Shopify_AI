{% doc %}
Renders Figma-styled collection sidebar filters. Uses Shopify filters when available.
@param {collection} results - Collection object
@param {object} section - Parent section for IDs
@param {boolean} [enable_filtering] - Enable filter form
@param {string} [form_id] - Form element ID (FacetFiltersForm or FacetFiltersFormMobile)
@param {string} [wrapper_id] - Wrapper element ID for filter groups
@param {string} [details_id_prefix] - Prefix for details element IDs (Mobile- for drawer)
@param {string} [facet_id_prefix] - Prefix for facet panel IDs
@param {string} [input_id_prefix] - Prefix for input IDs
@example
{% render 'custom-collection-facets', results: collection, section: section, enable_filtering: true %}
{% enddoc %}

{%- liquid
  assign form_id = form_id | default: 'FacetFiltersForm'
  assign wrapper_id = wrapper_id | default: 'FacetsWrapperDesktop'
  assign details_id_prefix = details_id_prefix | default: ''
  assign facet_id_prefix = facet_id_prefix | default: 'Facet-'
  assign input_id_prefix = input_id_prefix | default: 'Filter-'
  assign sort_by = results.sort_by | default: results.default_sort_by
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}

<div class="custom-collection-facets facets-container">
  {%- if enable_filtering -%}
    <facet-filters-form class="custom-collection-facets__form-wrap">
      <form id="{{ form_id }}" class="custom-collection-facets__form">
        {%- if results.filters.size > 0 -%}
          {%- liquid
            assign total_active_values = 0
            for filter in results.filters
              assign total_active_values = total_active_values | plus: filter.active_values.size
              if filter.type == 'price_range'
                if filter.min_value.value != null or filter.max_value.value != null
                  assign total_active_values = total_active_values | plus: 1
                endif
              endif
            endfor
          -%}

          {%- if total_active_values > 0 -%}
            <div class="custom-collection-facets__active{% if form_id == 'FacetFiltersFormMobile' %} custom-collection-facets__active--mobile{% endif %}">
              {%- for filter in results.filters -%}
                {%- for value in filter.active_values -%}
                  <facet-remove class="custom-collection-facets__active-tag">
                    <a href="{{ value.url_to_remove }}" class="custom-collection-facets__active-link">
                      <span>{{ filter.label | escape }}: {{ value.label | escape }}</span>
                      <span class="custom-collection-facets__active-remove" aria-hidden="true">
                        {{- 'icon-close-small.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                    </a>
                  </facet-remove>
                {%- endfor -%}
                {%- if filter.type == 'price_range' -%}
                  {%- liquid
                    assign min = filter.min_value.value
                    assign max = filter.max_value.value
                  -%}
                  {%- if min != null or max != null -%}
                    <facet-remove class="custom-collection-facets__active-tag">
                      <a href="{{ filter.url_to_remove }}" class="custom-collection-facets__active-link">
                        <span>{{ min | default: 0 | money }} – {{ max | default: filter.range_max | money }}</span>
                        <span class="custom-collection-facets__active-remove" aria-hidden="true">
                          {{- 'icon-close-small.svg' | inline_asset_content -}}
                        </span>
                        <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                      </a>
                    </facet-remove>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              <facet-remove class="custom-collection-facets__clear-all">
                <a href="{{ results_url }}" class="custom-collection-facets__clear-all-link">
                  {{ 'products.facets.clear_all' | t }}
                </a>
              </facet-remove>
            </div>
          {%- endif -%}

          <div id="{{ wrapper_id }}" class="custom-collection-facets__groups">
            {%- for filter in results.filters -%}
              {%- case filter.type -%}
                {%- when 'boolean', 'list' -%}
                  <details
                    id="Details-{{ details_id_prefix }}{{ filter.param_name | escape }}-{{ section.id }}"
                    class="custom-collection-filter js-filter"
                    data-index="{{ details_id_prefix | default: '' }}{{ forloop.index }}"
                    open
                  >
                    <summary class="custom-collection-filter__heading">
                      <span>{{ filter.label | escape | upcase }}</span>
                    </summary>
                    <div
                      id="{{ facet_id_prefix }}{{ forloop.index }}-{{ section.id }}"
                      class="custom-collection-filter__body"
                    >
                      <fieldset class="custom-collection-filter__fieldset">
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        <ul class="custom-collection-filter__list" role="list">
                          {%- liquid
                            assign sorted_values = filter.values
                            if filter.operator == 'AND'
                              assign active_filter_values = filter.values | where: 'active', true
                              assign inactive_filter_values = filter.values | where: 'active', false
                              assign sorted_values = active_filter_values | concat: inactive_filter_values
                            endif
                          -%}
                          {%- for value in sorted_values -%}
                            {%- liquid
                              assign input_id = input_id_prefix | append: filter.param_name | escape | append: '-' | append: forloop.index
                              assign is_disabled = false
                              if value.count == 0 and value.active == false
                                assign is_disabled = true
                              endif
                            -%}
                            <li class="custom-collection-filter__item">
                              <label
                                for="{{ input_id }}"
                                class="custom-collection-filter__label{% if is_disabled %} custom-collection-filter__label--disabled{% endif %}{% if value.active %} custom-collection-filter__label--active{% endif %}"
                              >
                                <input
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  id="{{ input_id }}"
                                  class="custom-collection-filter__input{% if form_id == 'FacetFiltersFormMobile' %} mobile-facets__checkbox{% endif %}"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                  {% if is_disabled %}
                                    disabled
                                  {% endif %}
                                >
                                <span class="custom-collection-filter__checkbox" aria-hidden="true"></span>
                                <span class="custom-collection-filter__text">
                                  {{- value.label | escape -}}
                                  {%- unless form_id == 'FacetFiltersFormMobile' -%}
                                    <span class="custom-collection-filter__count">({{ value.count }})</span>
                                  {%- endunless -%}
                                </span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </fieldset>
                    </div>
                  </details>
                {%- when 'price_range' -%}
                  <details
                    id="Details-{{ details_id_prefix }}{{ filter.param_name | escape }}-{{ section.id }}"
                    class="custom-collection-filter js-filter"
                    data-index="{{ details_id_prefix | default: '' }}{{ forloop.index }}"
                    open
                  >
                    <summary class="custom-collection-filter__heading">
                      <span>{{ filter.label | escape | upcase }}</span>
                    </summary>
                    <div
                      id="{{ facet_id_prefix }}{{ forloop.index }}-{{ section.id }}"
                      class="custom-collection-filter__body"
                    >
                      {%- assign max_price_amount = filter.range_max | money | strip_html | escape -%}
                      <p class="custom-collection-filter__price-hint">
                        {{ 'products.facets.max_price' | t: price: max_price_amount }}
                      </p>
                      <price-range class="custom-collection-filter__price-range">
                        {% render 'price-facet', filter: filter, id_prefix: input_id_prefix, filter_type: 'vertical' %}
                      </price-range>
                    </div>
                  </details>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- comment -%} Static Figma demo filters when store filters are not configured {%- endcomment -%}
          <div id="{{ wrapper_id }}" class="custom-collection-facets__groups">
            {%- for block in section.blocks -%}
              {%- if block.type == 'filter_group' -%}
                <div class="custom-collection-filter" {{ block.shopify_attributes }}>
                  <div class="custom-collection-filter__heading">
                    <span>{{ block.settings.title | escape | upcase }}</span>
                  </div>
                  <ul class="custom-collection-filter__list" role="list">
                    {%- assign options = block.settings.options | split: ',' -%}
                    {%- for option in options -%}
                      {%- assign option_label = option | strip -%}
                      {%- if option_label != blank -%}
                        <li class="custom-collection-filter__item">
                          <label class="custom-collection-filter__label">
                            <input type="checkbox" class="custom-collection-filter__input" disabled>
                            <span class="custom-collection-filter__checkbox" aria-hidden="true"></span>
                            <span class="custom-collection-filter__text">{{ option_label | escape }}</span>
                          </label>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </form>
    </facet-filters-form>
  {%- endif -%}
</div>
