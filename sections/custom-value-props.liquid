{{ 'section-custom-value-props.css' | asset_url | stylesheet_tag }}

<section class="custom-dr-section custom-value-props">
  <div class="page-width">
    <div class="custom-dr-section__header custom-value-props__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-dr-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="custom-value-props__grid">
      {%- for block in section.blocks -%}
        <div class="custom-value-props__item" {{ block.shopify_attributes }}>
          <div class="custom-value-props__icon" aria-hidden="true">
            {% render 'custom-theme-icon',
              image: block.settings.icon,
              class: 'custom-value-props__icon-image'
            %}
          </div>

          {%- if block.settings.title != blank -%}
            <h3 class="custom-value-props__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="custom-value-props__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="custom-dr-actions custom-value-props__actions">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="custom-dr-btn custom-dr-btn--outline-dark"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Value Props",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kind, not mined.™"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See comparison"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Same Composition"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Chemically, physically, optically identical to mined diamonds."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Value Props",
      "blocks": [
        { "type": "value", "settings": { "title": "Same Composition", "text": "Chemically, physically, optically identical to mined diamonds." } },
        { "type": "value", "settings": { "title": "Better Price", "text": "Get 30-50% more diamond for the same budget." } },
        { "type": "value", "settings": { "title": "Better Quality", "text": "IGI certified, flawless, and precision-cut craftsmanship." } },
        { "type": "value", "settings": { "title": "Better Ethics", "text": "100% conflict free, with no mining impact." } },
        { "type": "value", "settings": { "title": "Better Sustainability", "text": "85% less water & energy use, zero land displacement." } }
      ]
    }
  ]
}
{% endschema %}
