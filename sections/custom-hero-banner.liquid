{%- comment -%}
  Section: custom-hero-banner.liquid
  A full-width hero banner section with heading, subtext, CTA button and background image.

  CUSTOM FILE — Safe to modify freely.
  Follows Dawn OS 2.0 section architecture.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .custom-hero {
    position: relative;
    display: flex;
    align-items: {{ section.settings.content_position | split: ' ' | last }};
    justify-content: {{ section.settings.content_position | split: ' ' | first }};
    min-height: {{ section.settings.section_height }}px;
    overflow: hidden;
    padding: 4rem 2rem;
  }

  #shopify-section-{{ section.id }} .custom-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .custom-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .custom-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .custom-hero__content {
    position: relative;
    z-index: 2;
    max-width: 70rem;
    color: {{ section.settings.text_color }};
    text-align: {{ section.settings.text_alignment }};
  }

  #shopify-section-{{ section.id }} .custom-hero__heading {
    font-size: clamp(2.8rem, 5vw, 5.6rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.6rem;
  }

  #shopify-section-{{ section.id }} .custom-hero__subtext {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    margin-bottom: 2.4rem;
    opacity: 0.9;
  }
</style>

<div class="custom-hero">
  {%- if section.settings.image != blank -%}
    <div class="custom-hero__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt | default: section.settings.heading | escape,
          width: section.settings.image.width,
          height: section.settings.image.height
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="custom-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="custom-hero__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-hero__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="custom-hero__subtext">{{ section.settings.subtext | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a
        href="{{ section.settings.button_link }}"
        class="button button--primary"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom Hero Banner",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Shop the latest collection"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Section height",
      "default": 500
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "flex-start center", "label": "Left center" },
        { "value": "center center", "label": "Center" },
        { "value": "flex-end center", "label": "Right center" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
