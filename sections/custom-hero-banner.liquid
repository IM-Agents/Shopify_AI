{{ 'section-custom-hero-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.image
-%}

<section class="custom-dr-hero" style="--hero-min-height: {{ section.settings.section_height }}px;">
  <div class="custom-dr-hero__media" aria-hidden="true">
    {% render 'custom-theme-image',
      image: hero_image,
      default_asset: 'custom-hero-summer.png',
      alt: '',
      class: 'custom-dr-hero__image',
      loading: 'eager',
      priority: true,
      image_width: 2400,
      widths: '750, 1100, 1500, 1800, 2400',
      width: 1280,
      height: 620,
      placeholder: 'hero-apparel-3',
      placeholder_class: 'custom-dr-hero__placeholder'
    %}
  </div>

  <div class="custom-dr-hero__inner page-width">
    <div class="custom-dr-hero__card">
      {%- if section.settings.heading != blank -%}
        <h1 class="custom-dr-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="custom-dr-hero__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}

      {%- if section.settings.promo_text != blank -%}
        <p class="custom-dr-hero__promo">{{ section.settings.promo_text | escape }}</p>
      {%- endif -%}

      <div class="custom-dr-hero__actions">
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="custom-dr-btn custom-dr-btn--primary">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="custom-dr-btn custom-dr-btn--secondary">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Hero Banner",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Minimum section height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Summer Starts With \"Yes\""
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Rings made for forever moments"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo text",
      "default": "Up to 30% Off* Sitewide"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop engagement rings"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button label",
      "default": "Shop wedding rings"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
