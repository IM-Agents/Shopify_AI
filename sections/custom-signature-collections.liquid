{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-signature-collections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-filter-tabs.js' | asset_url }}" defer="defer"></script>

<custom-filter-tabs class="custom-dr-section custom-signature-collections">
  <div class="page-width">
    <div class="custom-dr-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-dr-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="custom-dr-pills" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- assign first_tab = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_tab' -%}
            <button
              type="button"
              class="custom-dr-pill{% if first_tab %} custom-dr-pill--active{% endif %}"
              role="tab"
              data-filter-trigger
              data-filter-target="{{ block.id }}"
              aria-selected="{% if first_tab %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title | escape }}
            </button>
            {%- assign first_tab = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign first_panel = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'collection_tab' -%}
        {%- assign tab_collection = block.settings.collection -%}
        <div
          class="custom-dr-filter-panel{% if first_panel %} custom-dr-filter-panel--active{% endif %}"
          data-filter-panel="{{ block.id }}"
          role="tabpanel"
          {% unless first_panel %}hidden{% endunless %}
        >
          {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
            <div class="custom-signature-collections__grid">
              {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                {%- assign figma_index = forloop.index | modulo: 4 -%}
                {%- if figma_index == 0 -%}{%- assign figma_index = 4 -%}{%- endif -%}
                {%- capture figma_default -%}{%- render 'custom-figma-asset', group: 'collection-product', index: figma_index -%}{%- endcapture -%}
                {% render 'custom-signature-product-card',
                  product: product,
                  badge_text: section.settings.badge_text,
                  overlay_text: section.settings.overlay_text,
                  default_asset: figma_default | strip
                %}
              {%- endfor -%}
            </div>
          {%- else -%}
            {%- assign demo_blocks = section.blocks | where: 'type', 'demo_product' -%}
            <div class="custom-signature-collections__grid">
              {%- if demo_blocks.size > 0 -%}
                {%- for demo_block in demo_blocks -%}
                  {%- assign figma_index = forloop.index | modulo: 4 -%}
                  {%- if figma_index == 0 -%}{%- assign figma_index = 4 -%}{%- endif -%}
                  {%- capture figma_default -%}{%- render 'custom-figma-asset', group: 'collection-product', index: figma_index -%}{%- endcapture -%}
                  {% render 'custom-signature-demo-card',
                    title: demo_block.settings.title,
                    price: demo_block.settings.price,
                    compare_price: demo_block.settings.compare_price,
                    image: demo_block.settings.image,
                    default_asset: figma_default | strip,
                    badge_text: section.settings.badge_text,
                    overlay_text: section.settings.overlay_text
                  %}
                {%- endfor -%}
              {%- else -%}
                {%- capture figma_default_1 -%}{%- render 'custom-figma-asset', group: 'collection-product', index: 1 -%}{%- endcapture -%}
                {%- capture figma_default_2 -%}{%- render 'custom-figma-asset', group: 'collection-product', index: 2 -%}{%- endcapture -%}
                {%- capture figma_default_3 -%}{%- render 'custom-figma-asset', group: 'collection-product', index: 3 -%}{%- endcapture -%}
                {%- capture figma_default_4 -%}{%- render 'custom-figma-asset', group: 'collection-product', index: 4 -%}{%- endcapture -%}
                {% render 'custom-signature-demo-card',
                  title: 'Nature Inspired Engagement Ring Using Dutch Marquise…',
                  price: '$1,021',
                  compare_price: '$1,459',
                  default_asset: figma_default_1 | strip,
                  badge_text: section.settings.badge_text,
                  overlay_text: section.settings.overlay_text
                %}
                {% render 'custom-signature-demo-card',
                  title: 'Vintage Engagement Ring with Marquise Cut Diamond Beauty',
                  price: '$873',
                  compare_price: '$1,248',
                  default_asset: figma_default_2 | strip,
                  badge_text: section.settings.badge_text,
                  overlay_text: section.settings.overlay_text
                %}
                {% render 'custom-signature-demo-card',
                  title: 'Three Stone Marquise Engagement Ring with Side Kite',
                  price: '$903',
                  compare_price: '$1,291',
                  default_asset: figma_default_3 | strip,
                  badge_text: section.settings.badge_text,
                  overlay_text: section.settings.overlay_text
                %}
                {% render 'custom-signature-demo-card',
                  title: 'Vintage Marquise Cut Diamond Ring - Timeless Elegance',
                  price: '$897',
                  compare_price: '$1,282',
                  default_asset: figma_default_4 | strip,
                  badge_text: section.settings.badge_text,
                  overlay_text: section.settings.overlay_text
                %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- assign first_panel = false -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.button_label != blank -%}
      <div class="custom-dr-actions">
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="custom-dr-btn custom-dr-btn--underline"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</custom-filter-tabs>

{% schema %}
{
  "name": "Signature Collections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Signature Collections"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products per tab",
      "default": 4
    },
    {
      "type": "text",
      "id": "overlay_text",
      "label": "Image overlay text",
      "default": "Lab Grown Diamond"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Best Seller"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all engagement rings"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "demo_product",
      "name": "Demo product",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nature Inspired Engagement Ring"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$1,021"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at price",
          "default": "$1,459"
        }
      ]
    },
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab label",
          "default": "Engagement rings"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Signature Collections",
      "blocks": [
        { "type": "collection_tab", "settings": { "title": "Engagement rings" } },
        { "type": "collection_tab", "settings": { "title": "Wedding bands" } },
        { "type": "collection_tab", "settings": { "title": "Earrings" } },
        { "type": "collection_tab", "settings": { "title": "Men's rings" } }
      ]
    }
  ]
}
{% endschema %}
