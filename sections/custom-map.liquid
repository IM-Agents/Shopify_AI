{%- liquid
  assign s = section.settings
-%}
<section
  class="custom-map"
  style="--map-bg: {{ s.background_color | escape }}; --map-fg: {{ s.text_color | escape }};"
>
  <div class="custom-map__inner custom-container">
    <div class="custom-map__info">
      {%- if s.heading != blank -%}
        <h2 class="custom-map__heading custom-display">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.address != blank -%}
        <div class="custom-map__address rte">{{ s.address }}</div>
      {%- endif -%}
      {%- if s.directions_label != blank and s.directions_url != blank -%}
        <a class="custom-btn custom-btn--secondary custom-map__directions" href="{{ s.directions_url }}" target="_blank" rel="noopener">{{ s.directions_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="custom-map__embed">
      {%- if s.map_embed_url != blank -%}
        <iframe
          src="{{ s.map_embed_url }}"
          class="custom-map__iframe"
          title="{{ s.heading | default: 'Map' | escape }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          allowfullscreen
        ></iframe>
      {%- else -%}
        <div class="custom-map__placeholder">{{ 'custom.map.placeholder' | t }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.custom-map {
  background-color: var(--map-bg, #000);
  color: var(--map-fg, #fff);
  padding-block: var(--custom-space-2xl, 32px);
}
.custom-map__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-xl, 24px);
  align-items: center;
}
.custom-map__heading { margin: 0 0 var(--custom-space-md, 12px); }
.custom-map__address { line-height: 1.6; }
.custom-map__directions { margin-top: var(--custom-space-md, 12px); }
.custom-map__embed { line-height: 0; }
.custom-map__iframe {
  width: 100%;
  aspect-ratio: 4 / 3;
  border: 0;
  border-radius: var(--custom-radius-md, 8px);
}
.custom-map__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 4 / 3;
  background: rgb(255 255 255 / 0.06);
  border-radius: var(--custom-radius-md, 8px);
  opacity: 0.7;
}
@media screen and (min-width: 750px) {
  .custom-map__inner { grid-template-columns: 1fr 1.2fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.map.name",
  "tag": "section",
  "class": "custom-map-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom.map.heading"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "t:custom.map.address"
    },
    {
      "type": "url",
      "id": "map_embed_url",
      "label": "t:custom.map.embed_url",
      "info": "t:custom.map.embed_url_info"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "t:custom.map.directions_label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "t:custom.map.directions_url"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:custom.map.background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:custom.map.text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:custom.map.name"
    }
  ]
}
{% endschema %}
