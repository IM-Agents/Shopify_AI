{%- liquid
  assign s = section.settings
-%}
<section
  class="custom-iwt custom-iwt--img-{{ s.image_position }}"
  style="--iwt-bg: {{ s.background_color | escape }}; --iwt-fg: {{ s.text_color | escape }};"
>
  <div class="custom-iwt__inner custom-container">
    <div class="custom-iwt__media custom-iwt__media--{{ s.image_ratio }}">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            class: 'custom-iwt__img',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 600px, 100vw',
            alt: s.image.alt | default: s.heading
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-iwt__img custom-iwt__placeholder' }}
      {%- endif -%}
    </div>
    <div class="custom-iwt__text">
      {%- if s.eyebrow != blank -%}
        <p class="custom-iwt__eyebrow custom-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="custom-iwt__heading custom-display">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="custom-iwt__body rte">{{ s.body }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="custom-btn custom-btn--primary custom-iwt__btn" {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}href="#" aria-disabled="true"{% endif %}>{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.custom-iwt {
  background-color: var(--iwt-bg, #000);
  color: var(--iwt-fg, #fff);
  padding-block: var(--custom-space-2xl, 32px);
}
.custom-iwt__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-xl, 24px);
  align-items: center;
}
.custom-iwt__media { line-height: 0; }
.custom-iwt__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: var(--custom-radius-md, 8px);
}
.custom-iwt__media--square { aspect-ratio: 1 / 1; }
.custom-iwt__media--portrait { aspect-ratio: 3 / 4; }
.custom-iwt__media--landscape { aspect-ratio: 4 / 3; }
.custom-iwt__media--natural { aspect-ratio: auto; }
.custom-iwt__text {
  display: flex;
  flex-direction: column;
  gap: var(--custom-space-md, 12px);
}
.custom-iwt__heading { margin: 0; }
.custom-iwt__btn { align-self: flex-start; }
@media screen and (min-width: 750px) {
  .custom-iwt__inner { grid-template-columns: 1fr 1fr; }
  .custom-iwt--img-right .custom-iwt__media { order: 2; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.image_with_text.name",
  "tag": "section",
  "class": "custom-iwt-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:custom.image_with_text.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:custom.image_with_text.image_position",
      "options": [
        { "value": "left", "label": "t:custom.image_with_text.pos_left" },
        { "value": "right", "label": "t:custom.image_with_text.pos_right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:custom.image_with_text.image_ratio",
      "options": [
        { "value": "square", "label": "t:custom.image_with_text.ratio_square" },
        { "value": "portrait", "label": "t:custom.image_with_text.ratio_portrait" },
        { "value": "landscape", "label": "t:custom.image_with_text.ratio_landscape" },
        { "value": "natural", "label": "t:custom.image_with_text.ratio_natural" }
      ],
      "default": "landscape"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:custom.image_with_text.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom.image_with_text.heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:custom.image_with_text.body"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:custom.image_with_text.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:custom.image_with_text.button_link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:custom.image_with_text.background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:custom.image_with_text.text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:custom.image_with_text.name"
    }
  ]
}
{% endschema %}
