{{ 'section-custom-top-bar.css' | asset_url | stylesheet_tag }}

<div class="custom-top-bar">
  <div class="custom-top-bar__inner page-width">
    <ul class="custom-top-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="custom-top-bar__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="custom-top-bar__link">
              {{- block.settings.text | escape -}}
            </a>
          {%- else -%}
            <span class="custom-top-bar__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Custom Top Bar",
  "tag": "section",
  "class": "custom-top-bar-section",
  "limit": 1,
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Top Bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Worldwide Delivery" } },
        { "type": "message", "settings": { "text": "Free Shipping" } },
        { "type": "message", "settings": { "text": "30-Day Returns" } }
      ]
    }
  ]
}
{% endschema %}
