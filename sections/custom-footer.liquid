{%- liquid
  assign s = section.settings
-%}
<footer
  class="custom-footer"
  style="--cf-bg: {{ s.background_color | escape }}; --cf-fg: {{ s.text_color | escape }}; --cf-logo-w: {{ s.logo_width | escape }}px;"
  role="contentinfo"
>
  <div class="custom-footer__inner custom-container">
    <div class="custom-footer__brand">
      <a href="{{ routes.root_url }}" class="custom-footer__logo" aria-label="{{ shop.name | escape }}">
        {%- if s.logo != blank -%}
          {{
            s.logo
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              class: 'custom-footer__logo-img',
              widths: '120, 200, 300, 600',
              sizes: '200px',
              alt: shop.name
          }}
        {%- else -%}
          <span class="custom-footer__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if s.about_text != blank -%}
        <div class="custom-footer__about rte">{{ s.about_text }}</div>
      {%- endif -%}
      {%- if s.contact_text != blank -%}
        <div class="custom-footer__contact rte">{{ s.contact_text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="custom-footer__menus">
        {%- for block in section.blocks -%}
          {%- liquid
            assign menu = linklists[block.settings.menu]
          -%}
          <div class="custom-footer__menu" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="custom-footer__menu-title">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if menu != blank and menu.links.size > 0 -%}
              <ul class="custom-footer__menu-list" role="list">
                {%- for link in menu.links -%}
                  <li><a class="custom-footer__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.enable_newsletter -%}
      <div class="custom-footer__newsletter">
        {%- if s.newsletter_text != blank -%}
          <p class="custom-footer__newsletter-text">{{ s.newsletter_text | escape }}</p>
        {%- endif -%}
        {%- form 'customer', class: 'custom-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="CustomFooterEmail">{{ 'custom.footer.email_label' | t }}</label>
          <div class="custom-footer__form-row">
            <input
              id="CustomFooterEmail"
              type="email"
              name="contact[email]"
              class="custom-footer__input"
              value="{{ form.email }}"
              placeholder="{{ 'custom.footer.email_label' | t }}"
              autocomplete="email"
              aria-required="true"
              {% if form.errors %}aria-invalid="true"{% endif %}
              required
            >
            <button type="submit" class="custom-btn custom-btn--primary custom-footer__submit" name="commit">
              {{ s.newsletter_button | default: 'Subscribe' | escape }}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="custom-footer__form-msg custom-footer__form-msg--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- elsif form.posted_successfully? -%}
            <p class="custom-footer__form-msg custom-footer__form-msg--success" role="status">
              {{ 'custom.footer.newsletter_success' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  {%- if s.show_social -%}
    {%- liquid
      assign has_social = false
      if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank
        assign has_social = true
      endif
    -%}
    {%- if has_social -%}
      <ul class="custom-footer__social custom-container" role="list">
        {%- if settings.social_facebook_link != blank -%}
          <li><a class="custom-footer__social-link" href="{{ settings.social_facebook_link }}" aria-label="Facebook">{% render 'custom-icon', icon: 'facebook', class: 'custom-footer__social-icon' %}</a></li>
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          <li><a class="custom-footer__social-link" href="{{ settings.social_instagram_link }}" aria-label="Instagram">{% render 'custom-icon', icon: 'instagram', class: 'custom-footer__social-icon' %}</a></li>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <li><a class="custom-footer__social-link" href="{{ settings.social_tiktok_link }}" aria-label="TikTok">{% render 'custom-icon', icon: 'tiktok', class: 'custom-footer__social-icon' %}</a></li>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <li><a class="custom-footer__social-link" href="{{ settings.social_youtube_link }}" aria-label="YouTube">{% render 'custom-icon', icon: 'youtube', class: 'custom-footer__social-icon' %}</a></li>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <li><a class="custom-footer__social-link" href="{{ settings.social_twitter_link }}" aria-label="X">{% render 'custom-icon', icon: 'twitter', class: 'custom-footer__social-icon' %}</a></li>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <li><a class="custom-footer__social-link" href="{{ settings.social_pinterest_link }}" aria-label="Pinterest">{% render 'custom-icon', icon: 'pinterest', class: 'custom-footer__social-icon' %}</a></li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  {%- endif -%}

  <div class="custom-footer__bottom custom-container">
    <p class="custom-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% stylesheet %}
.custom-footer {
  background-color: var(--cf-bg, #000);
  color: var(--cf-fg, #fff);
  padding-block: var(--custom-space-2xl, 32px) var(--custom-space-lg, 16px);
}
.custom-footer__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-xl, 24px);
}
.custom-footer__logo-img {
  width: var(--cf-logo-w, 200px);
  height: auto;
  display: block;
}
.custom-footer__logo-text {
  font-family: var(--font-heading-family);
  font-size: 1.5rem;
}
.custom-footer__about,
.custom-footer__contact {
  font-size: 0.8125rem;
  line-height: 1.5;
  margin-top: var(--custom-space-md, 12px);
  opacity: 0.9;
}
.custom-footer__menus {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--custom-space-lg, 16px);
}
.custom-footer__menu-title {
  font-size: 1rem;
  margin: 0 0 var(--custom-space-sm, 8px);
  text-transform: uppercase;
  letter-spacing: var(--custom-letter-spacing-labels, 1px);
}
.custom-footer__menu-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.custom-footer__menu-link {
  color: inherit;
  text-decoration: none;
  font-size: 0.875rem;
  opacity: 0.9;
}
.custom-footer__menu-link:hover {
  opacity: 1;
  color: var(--custom-color-accent, currentColor);
}
.custom-footer__newsletter-text {
  margin: 0 0 var(--custom-space-sm, 8px);
  font-size: 0.9375rem;
}
.custom-footer__form-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--custom-space-xs, 6px);
}
.custom-footer__input {
  flex: 1 1 12rem;
  padding: 10px 12px;
  border: 1px solid currentColor;
  border-radius: var(--custom-radius-sm, 4px);
  background: transparent;
  color: inherit;
  font: inherit;
}
.custom-footer__input::placeholder { color: currentColor; opacity: 0.7; }
.custom-footer__form-msg { margin: var(--custom-space-xs, 6px) 0 0; font-size: 0.8125rem; }
.custom-footer__form-msg--error { color: #ff8a8a; }
.custom-footer__social {
  display: flex;
  gap: var(--custom-space-sm, 8px);
  list-style: none;
  margin: var(--custom-space-lg, 16px) auto 0;
  padding-inline: var(--custom-space-md, 12px);
  justify-content: flex-end;
}
.custom-footer__social-link {
  display: inline-flex;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  color: inherit;
}
.custom-footer__social-icon { width: 22px; height: 22px; }
.custom-footer__bottom {
  margin-top: var(--custom-space-lg, 16px);
  padding-top: var(--custom-space-md, 12px);
  border-top: 1px solid rgb(255 255 255 / 0.15);
}
.custom-footer__copyright { margin: 0; font-size: 0.8125rem; opacity: 0.8; }

@media screen and (min-width: 990px) {
  .custom-footer__inner {
    grid-template-columns: 1.2fr 2fr 1.4fr;
    align-items: start;
  }
  .custom-footer__menus {
    grid-template-columns: repeat(3, 1fr);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.footer.name",
  "tag": "footer",
  "class": "custom-footer-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:custom.footer.brand_header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:custom.footer.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "t:custom.footer.logo_width",
      "default": 200
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "t:custom.footer.about_text"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "t:custom.footer.contact_text"
    },
    {
      "type": "header",
      "content": "t:custom.footer.newsletter_header"
    },
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "label": "t:custom.footer.enable_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "t:custom.footer.newsletter_text"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "t:custom.footer.newsletter_button",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "t:custom.footer.social_header"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:custom.footer.show_social",
      "info": "t:custom.footer.show_social_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:custom.footer.appearance_header"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:custom.footer.background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:custom.footer.text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:custom.footer.menu_block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:custom.footer.menu_heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:custom.footer.menu"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:custom.footer.name",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
