{{ 'section-custom-footer.css' | asset_url | stylesheet_tag }}

<footer class="custom-dr-footer">
  <div class="custom-dr-footer__inner page-width">
    <div class="custom-dr-footer__grid">
      <div class="custom-dr-footer__brand">
        <a href="{{ routes.root_url }}" class="custom-dr-footer__logo">
          {{- section.settings.brand_name | escape -}}
        </a>

        {%- if section.settings.email != blank -%}
          <p class="custom-dr-footer__contact">
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a>
          </p>
        {%- endif -%}

        {%- if section.settings.phone != blank -%}
          <p class="custom-dr-footer__contact">
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
              {{- section.settings.phone | escape -}}
            </a>
          </p>
        {%- endif -%}

        {%- if section.settings.appointment_label != blank -%}
          <a
            href="{{ section.settings.appointment_link | default: '#' }}"
            class="custom-dr-footer__appointment"
          >
            {{- section.settings.appointment_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="custom-dr-footer__column" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="custom-dr-footer__heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}

          <ul class="custom-dr-footer__links" role="list">
            {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
              {%- for link in block.settings.menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="custom-dr-footer__link">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..5) -%}
                {%- liquid
                  assign text_key = 'link_' | append: i | append: '_text'
                  assign url_key = 'link_' | append: i | append: '_url'
                  assign link_text = block.settings[text_key]
                  assign link_url = block.settings[url_key]
                -%}
                {%- if link_text != blank -%}
                  <li>
                    <a href="{{ link_url | default: '#' }}" class="custom-dr-footer__link">
                      {{- link_text | escape -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="custom-dr-footer__bottom">
      {%- if section.settings.copyright != blank -%}
        <p class="custom-dr-footer__copyright">{{ section.settings.copyright | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_payment_labels -%}
        <ul class="custom-dr-footer__payments" role="list">
          <li>Visa</li>
          <li>Mastercard</li>
          <li>Amex</li>
          <li>Paypal</li>
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "DIAMONDRENSU"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@diamondrensu.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(+91) 90239-30923"
    },
    {
      "type": "text",
      "id": "appointment_label",
      "label": "Appointment label",
      "default": "Virtual Appointment"
    },
    {
      "type": "url",
      "id": "appointment_link",
      "label": "Appointment link"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2026 Diamondrensu. All Rights Reserved. Proudly Crafted in Surat."
    },
    {
      "type": "checkbox",
      "id": "show_payment_labels",
      "label": "Show payment labels",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Company"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Optional. Leave empty to use manual links below."
        },
        {
          "type": "header",
          "content": "Manual links (fallback)"
        },
        {
          "type": "text",
          "id": "link_1_text",
          "label": "Link 1 text"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Link 1 URL"
        },
        {
          "type": "text",
          "id": "link_2_text",
          "label": "Link 2 text"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "link_3_text",
          "label": "Link 3 text"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Link 3 URL"
        },
        {
          "type": "text",
          "id": "link_4_text",
          "label": "Link 4 text"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4 URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}
