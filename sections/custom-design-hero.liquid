{{ 'section-custom-design.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_image = section.settings.image
-%}

<section class="custom-design-hero" id="CustomDesignHero">
  <div class="custom-design-hero__bg" aria-hidden="true">
    {% render 'custom-theme-image',
      image: hero_image,
      default_asset: 'custom-design-hero-4196a4.png',
      alt: '',
      class: 'custom-design-hero__bg-image',
      loading: 'eager',
      priority: true,
      image_width: 2000,
      widths: '750, 1100, 1500, 2000',
      sizes: '100vw',
      placeholder: 'hero-apparel-3',
      placeholder_class: 'custom-design-hero__placeholder'
    %}
    <div class="custom-design-hero__overlay"></div>
  </div>

  <div class="custom-design-hero__card">
    {%- if section.settings.eyebrow != blank -%}
      <p class="custom-design-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="custom-design-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="custom-design-hero__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: '#CustomDesignInquiry' }}"
        class="custom-dr-btn custom-dr-btn--primary"
        {% if section.settings.button_link == blank %}data-scroll-to-inquiry{% endif %}
      >
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'custom-design.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Design Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bespoke Concierge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Perfect Ring, Made to Order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>From stone to setting, we craft every ring by hand, just the way you want it. Experience the luxury of dedicated design.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Your Design"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Design Hero"
    }
  ]
}
{% endschema %}
