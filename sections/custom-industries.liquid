{%- liquid
  assign s = section.settings
-%}
<section
  class="custom-industries"
  style="--in-bg: {{ s.background_color | escape }}; --in-fg: {{ s.text_color | escape }};"
>
  <div class="custom-container">
    {%- if s.heading != blank -%}
      <h2 class="custom-industries__heading custom-display">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="custom-industries__sub">{{ s.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="custom-industries__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="custom-industries__item" {{ block.shopify_attributes }}>
            <div class="custom-industries__card">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'custom-industries__img',
                    widths: '300, 450, 600',
                    sizes: '(min-width: 990px) 20vw, 50vw',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-industries__placeholder' }}
              {%- endif -%}
              <div class="custom-industries__overlay" aria-hidden="true"></div>
              {%- if block.settings.title != blank -%}
                <h3 class="custom-industries__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.custom-industries {
  background-color: var(--in-bg, #fff);
  color: var(--in-fg, #252b37);
  padding-block: var(--custom-space-3xl, 48px);
}
.custom-industries__heading {
  margin: 0 0 var(--custom-space-sm, 8px);
  text-align: center;
  font-size: clamp(2rem, 4vw, 3rem);
}
.custom-industries__sub {
  margin: 0 auto var(--custom-space-2xl, 32px);
  text-align: center;
  color: var(--custom-color-secondary, #535862);
  font-size: 1.125rem;
}
.custom-industries__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-md, 12px);
}
.custom-industries__card {
  position: relative;
  border-radius: var(--custom-radius-lg, 16px);
  overflow: hidden;
  min-height: 200px;
}
.custom-industries__img,
.custom-industries__placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  object-fit: cover;
  display: block;
}
.custom-industries__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgb(0 0 0 / 0.65));
}
.custom-industries__title {
  position: absolute;
  left: var(--custom-space-lg, 16px);
  right: var(--custom-space-lg, 16px);
  bottom: var(--custom-space-lg, 16px);
  margin: 0;
  color: #fff;
  font-size: 1.125rem;
  font-weight: 600;
}
@media screen and (min-width: 750px) {
  .custom-industries__grid { grid-template-columns: repeat(3, 1fr); }
  .custom-industries__card { min-height: 280px; }
}
@media screen and (min-width: 990px) {
  .custom-industries__grid { grid-template-columns: repeat(5, 1fr); }
  .custom-industries__card { min-height: 398px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Industries we serve",
  "tag": "section",
  "class": "custom-industries-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Industries we serve"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted by manufacturers across multiple sectors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#252B37"
    }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Industry"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Industries we serve",
      "blocks": [
        { "type": "industry", "settings": { "title": "Automotive" } },
        { "type": "industry", "settings": { "title": "Electronics" } },
        { "type": "industry", "settings": { "title": "Construction" } },
        { "type": "industry", "settings": { "title": "Heavy Manufacturing" } },
        { "type": "industry", "settings": { "title": "Aerospace" } }
      ]
    }
  ]
}
{% endschema %}
