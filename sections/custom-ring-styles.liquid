{{ 'section-custom-ring-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-filter-tabs.js' | asset_url }}" defer="defer"></script>

<custom-filter-tabs class="custom-dr-section custom-ring-styles">
  <div class="page-width">
    <div class="custom-dr-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-dr-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="custom-dr-pills" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- assign first_tab = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <button
              type="button"
              class="custom-dr-pill{% if first_tab %} custom-dr-pill--active{% endif %}"
              role="tab"
              data-filter-trigger
              data-filter-target="{{ block.id }}"
              aria-selected="{% if first_tab %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title | escape }}
            </button>
            {%- assign first_tab = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign first_panel = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        <div
          class="custom-dr-filter-panel{% if first_panel %} custom-dr-filter-panel--active{% endif %}"
          data-filter-panel="{{ block.id }}"
          role="tabpanel"
          {% unless first_panel %}hidden{% endunless %}
        >
          <div class="custom-ring-styles__grid">
            {%- for style_block in section.blocks -%}
              {%- if style_block.type == 'style' and style_block.settings.tab_key == block.settings.tab_key -%}
                {%- liquid
                  assign style_figma_key = blank
                  case style_block.settings.title
                    when 'Nature Inspired'
                      assign style_figma_key = 'ring-nature-inspired'
                    when 'Solitaire'
                      assign style_figma_key = 'ring-solitaire'
                    when 'Halo'
                      assign style_figma_key = 'ring-halo'
                    when 'Three Stone'
                      assign style_figma_key = 'ring-three-stone'
                    when 'Pave'
                      assign style_figma_key = 'ring-pave'
                    when 'Vintage'
                      assign style_figma_key = 'ring-vintage'
                  endcase
                -%}
                {%- capture style_default_asset -%}
                  {%- if style_figma_key != blank -%}
                    {%- render 'custom-figma-asset', key: style_figma_key -%}
                  {%- endif -%}
                {%- endcapture -%}
                <a href="{{ style_block.settings.link | default: '#' }}" class="custom-ring-styles__card">
                  <div class="custom-ring-styles__media">
                    {% render 'custom-theme-image',
                      image: style_block.settings.image,
                      default_asset: style_default_asset | strip,
                      alt: style_block.settings.title,
                      class: 'custom-ring-styles__image',
                      image_width: 600,
                      widths: '200, 300, 400, 600',
                      placeholder: 'product-apparel-2',
                      placeholder_class: 'custom-ring-styles__placeholder'
                    %}
                  </div>
                  <h3 class="custom-ring-styles__title">{{ style_block.settings.title | escape }}</h3>
                  {%- if style_block.settings.item_count != blank -%}
                    <p class="custom-ring-styles__count">{{ style_block.settings.item_count | escape }}</p>
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- assign first_panel = false -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</custom-filter-tabs>

{% schema %}
{
  "name": "Custom Ring Styles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Popular Ring Styles"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Filter tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab label",
          "default": "Lab-grown diamond"
        },
        {
          "type": "text",
          "id": "tab_key",
          "label": "Tab key",
          "info": "Match this key on style blocks",
          "default": "lab-grown"
        }
      ]
    },
    {
      "type": "style",
      "name": "Ring style",
      "settings": [
        {
          "type": "text",
          "id": "tab_key",
          "label": "Tab key",
          "default": "lab-grown"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nature Inspired"
        },
        {
          "type": "text",
          "id": "item_count",
          "label": "Item count label",
          "default": "47 items"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Ring Styles",
      "blocks": [
        { "type": "tab", "settings": { "title": "Lab-grown diamond", "tab_key": "lab-grown" } },
        { "type": "tab", "settings": { "title": "Moissanite", "tab_key": "moissanite" } },
        { "type": "style", "settings": { "tab_key": "lab-grown", "title": "Nature Inspired", "item_count": "47 items", "link": "shopify://collections/all" } },
        { "type": "style", "settings": { "tab_key": "lab-grown", "title": "Solitaire", "item_count": "212 items", "link": "shopify://collections/all" } },
        { "type": "style", "settings": { "tab_key": "lab-grown", "title": "Halo", "item_count": "163 items", "link": "shopify://collections/all" } },
        { "type": "style", "settings": { "tab_key": "lab-grown", "title": "Three Stone", "item_count": "120 items", "link": "shopify://collections/all" } },
        { "type": "style", "settings": { "tab_key": "lab-grown", "title": "Pave", "item_count": "364 items", "link": "shopify://collections/all" } },
        { "type": "style", "settings": { "tab_key": "lab-grown", "title": "Vintage", "item_count": "63 items", "link": "shopify://collections/all" } }
      ]
    }
  ]
}
{% endschema %}
