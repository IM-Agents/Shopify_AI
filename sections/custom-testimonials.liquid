{{ 'section-custom-testimonials.css' | asset_url | stylesheet_tag }}

<section class="custom-dr-section custom-testimonials">
  <div class="page-width">
    <div class="custom-dr-section__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-dr-section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="custom-dr-section__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    <div class="custom-testimonials__grid custom-testimonials__grid--{{ section.settings.layout }}">
      {%- for block in section.blocks -%}
        <article class="custom-testimonials__card" {{ block.shopify_attributes }}>
          {%- if block.settings.author != blank -%}
            <h3 class="custom-testimonials__name">{{ block.settings.author | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.role != blank -%}
            <p class="custom-testimonials__meta">{{ block.settings.role | escape }}</p>
          {%- endif -%}

          {%- if block.settings.story_title != blank -%}
            <p class="custom-testimonials__story-title">{{ block.settings.story_title | escape }}</p>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <p class="custom-testimonials__quote">{{ block.settings.quote | escape }}</p>
          {%- endif -%}

          {%- if block.settings.read_more_label != blank and block.settings.read_more_link != blank -%}
            <a href="{{ block.settings.read_more_link }}" class="custom-testimonials__read-more">
              {{- block.settings.read_more_label | escape -}}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="custom-dr-actions">
        <a href="{{ section.settings.button_link }}" class="custom-dr-btn custom-dr-btn--outline-dark">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Customers"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Hear from those who've experienced our craftsmanship firsthand."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Horizontal scroll" }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See all customer stories"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Location and date",
          "default": "City, State | Month Day, Year"
        },
        {
          "type": "text",
          "id": "story_title",
          "label": "Story title",
          "default": "Engaged for Life"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Great quality and fast shipping."
        },
        {
          "type": "text",
          "id": "read_more_label",
          "label": "Read more label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "read_more_link",
          "label": "Read more link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
