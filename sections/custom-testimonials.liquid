{%- liquid
  assign s = section.settings
-%}
<section
  class="custom-testimonials"
  style="--tm-bg: {{ s.background_color | escape }}; --tm-fg: {{ s.text_color | escape }}; --tm-cols: {{ s.columns | escape }};"
>
  <div class="custom-container">
    {%- if s.heading != blank -%}
      <h2 class="custom-testimonials__heading custom-display">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="custom-testimonials__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="custom-testimonials__item" {{ block.shopify_attributes }}>
            {%- if block.settings.rating > 0 -%}
              <span class="custom-testimonials__stars" aria-label="{{ block.settings.rating }} / 5">
                {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
              </span>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="custom-testimonials__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            <div class="custom-testimonials__author">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 96 | image_tag: loading: 'lazy', class: 'custom-testimonials__avatar', widths: '48, 72, 96', sizes: '48px', alt: block.settings.author }}
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <span class="custom-testimonials__name">{{ block.settings.author | escape }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.custom-testimonials {
  --tm-cols: 3;
  background-color: var(--tm-bg, #000);
  color: var(--tm-fg, #fff);
  padding-block: var(--custom-space-2xl, 32px);
}
.custom-testimonials__heading { margin: 0 0 var(--custom-space-lg, 16px); text-align: center; }
.custom-testimonials__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-lg, 16px);
}
.custom-testimonials__item {
  display: flex;
  flex-direction: column;
  gap: var(--custom-space-sm, 8px);
  padding: var(--custom-space-lg, 16px);
  border: 1px solid rgb(255 255 255 / 0.15);
  border-radius: var(--custom-radius-md, 8px);
}
.custom-testimonials__stars { color: var(--custom-color-accent, #c89b3c); letter-spacing: 2px; }
.custom-testimonials__quote { margin: 0; font-style: italic; }
.custom-testimonials__author { display: flex; align-items: center; gap: 8px; margin-top: auto; }
.custom-testimonials__avatar { width: 40px; height: 40px; border-radius: 9999px; object-fit: cover; }
.custom-testimonials__name { font-weight: 600; font-size: 0.875rem; }
@media screen and (min-width: 750px) {
  .custom-testimonials__grid { grid-template-columns: repeat(2, 1fr); }
}
@media screen and (min-width: 990px) {
  .custom-testimonials__grid { grid-template-columns: repeat(var(--tm-cols, 3), 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.testimonials.name",
  "tag": "section",
  "class": "custom-testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom.testimonials.heading",
      "default": "What people say"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:custom.testimonials.columns",
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:custom.testimonials.background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:custom.testimonials.text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:custom.testimonials.block",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:custom.testimonials.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:custom.testimonials.author"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "t:custom.testimonials.rating",
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:custom.testimonials.avatar"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:custom.testimonials.name",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
