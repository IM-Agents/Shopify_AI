{%- liquid
  assign s = section.settings
  assign blog = blogs[s.blog]
-%}
<section
  class="custom-blog"
  style="--cbl-bg: {{ s.background_color | escape }}; --cbl-fg: {{ s.text_color | escape }}; --cbl-cols: {{ s.columns | escape }};"
>
  <div class="custom-container">
    <div class="custom-blog__head">
      {%- if s.heading != blank -%}
        <h2 class="custom-blog__heading custom-display">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.link_label != blank -%}
        <a class="custom-blog__link" href="{{ s.link_url | default: blog.url }}">{{ s.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if blog != blank and blog.articles.size > 0 -%}
      <ul class="custom-blog__grid" role="list">
        {%- for article in blog.articles limit: s.posts_count -%}
          <li class="custom-blog__item">
            <a class="custom-blog__card" href="{{ article.url }}">
              <div class="custom-blog__media">
                {%- if article.image != blank -%}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'custom-blog__img',
                      widths: '300, 450, 600, 800',
                      sizes: '(min-width: 990px) 400px, 90vw',
                      alt: article.image.alt | default: article.title
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'custom-blog__img custom-blog__placeholder' }}
                {%- endif -%}
                <span class="custom-blog__overlay" aria-hidden="true"></span>
                <span class="custom-blog__title">{{ article.title | escape }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="custom-blog__empty">{{ 'custom.blog.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.custom-blog {
  --cbl-cols: 3;
  background-color: var(--cbl-bg, #000);
  color: var(--cbl-fg, #fff);
  padding-block: var(--custom-space-2xl, 32px);
}
.custom-blog__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--custom-space-md, 12px);
  margin-bottom: var(--custom-space-lg, 16px);
}
.custom-blog__heading { margin: 0; }
.custom-blog__link {
  color: inherit;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: var(--custom-letter-spacing-labels, 1px);
  font-size: 0.875rem;
  white-space: nowrap;
}
.custom-blog__link:hover { color: var(--custom-color-accent, currentColor); }
.custom-blog__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-md, 12px);
}
.custom-blog__card {
  display: block;
  color: inherit;
  text-decoration: none;
}
.custom-blog__media {
  position: relative;
  display: grid;
  aspect-ratio: 2 / 1;
  overflow: hidden;
  border-radius: var(--custom-radius-md, 8px);
}
.custom-blog__media > * { grid-area: 1 / 1; }
.custom-blog__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.custom-blog__overlay {
  background: rgb(0 0 0 / 0.35);
}
.custom-blog__title {
  align-self: center;
  justify-self: center;
  z-index: 1;
  padding: 0 var(--custom-space-sm, 8px);
  text-align: center;
  font-family: var(--font-heading-family);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: var(--custom-letter-spacing-labels, 1px);
}
@media screen and (min-width: 750px) {
  .custom-blog__grid { grid-template-columns: repeat(2, 1fr); }
}
@media screen and (min-width: 990px) {
  .custom-blog__grid { grid-template-columns: repeat(var(--cbl-cols, 3), 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.blog.name",
  "tag": "section",
  "class": "custom-blog-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom.blog.heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:custom.blog.link_label",
      "default": "VAI AL BLOG"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:custom.blog.link_url"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:custom.blog.blog"
    },
    {
      "type": "range",
      "id": "posts_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:custom.blog.posts_count",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:custom.blog.columns",
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:custom.blog.background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:custom.blog.text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:custom.blog.name"
    }
  ]
}
{% endschema %}
