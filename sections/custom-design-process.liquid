{{ 'section-custom-design.css' | asset_url | stylesheet_tag }}

<section class="custom-design-process">
  <div class="page-width">
    <header class="custom-design-process__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-design-process__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="custom-design-process__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </header>

    <div class="custom-design-process__steps">
      {%- for block in section.blocks -%}
        {%- liquid
          assign step_image = block.settings.image
          assign reverse_class = ''
          if forloop.index == 2 or forloop.index == 4
            assign reverse_class = ' custom-design-process__step--reverse'
          endif
        -%}
        {%- capture step_default_asset -%}{%- render 'custom-figma-asset', group: 'design-process', index: forloop.index -%}{%- endcapture -%}
        <article class="custom-design-process__step{{ reverse_class }}" {{ block.shopify_attributes }}>
          <div class="custom-design-process__content">
            <p class="custom-design-process__number">{{ block.settings.number | escape }}</p>
            <h3 class="custom-design-process__title">{{ block.settings.title | escape }}</h3>
            <p class="custom-design-process__text">{{ block.settings.text | escape }}</p>
          </div>
          <div class="custom-design-process__media">
            {% render 'custom-theme-image',
              image: step_image,
              default_asset: step_default_asset | strip,
              alt: block.settings.title,
              class: 'custom-design-process__image',
              image_width: 900,
              widths: '400, 600, 900',
              placeholder: 'image',
              placeholder_class: 'custom-design-process__placeholder'
            %}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Design Process",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Creation Process"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "A seamless, collaborative journey to bring your vision to life."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Consult"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Share your ideas, inspirations, and budget."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Design Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Consult",
            "text": "Share your ideas, inspirations, and budget. Our expert designers will guide you through the possibilities, ensuring every detail reflects your unique story."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Design",
            "text": "We translate your vision into highly detailed 3D CAD renderings. You'll review the digital model from every angle, requesting adjustments until it's absolutely perfect."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Craft",
            "text": "Once approved, our master artisans in Surat meticulously cast, set, and polish your ring by hand. We use only the finest materials and ethical lab-grown diamonds or moissanite."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "04",
            "title": "Deliver",
            "text": "Your bespoke creation is securely packaged and shipped worldwide in unmarked boxes for ultimate privacy, arriving ready for that unforgettable moment."
          }
        }
      ]
    }
  ]
}
{% endschema %}
