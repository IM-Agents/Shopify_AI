{%- liquid
  assign s = section.settings
  assign coll = s.collection
-%}
<section
  class="custom-featured"
  style="--cf-bg: {{ s.background_color | escape }}; --cf-fg: {{ s.text_color | escape }}; --cf-cols: {{ s.columns | escape }};"
>
  <div class="custom-container">
    <div class="custom-featured__head">
      {%- if s.heading != blank -%}
        <h2 class="custom-featured__heading custom-display">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.link_label != blank -%}
        <a class="custom-featured__link" href="{{ s.link_url | default: coll.url }}">
          {{ s.link_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if coll != blank and coll.products.size > 0 -%}
      <ul class="custom-featured__grid" role="list">
        {%- for product in coll.products limit: s.products_count -%}
          <li class="custom-featured__item">
            {% render 'custom-product-card',
              product: product,
              show_price: s.show_price,
              show_tagline: s.show_tagline,
              image_ratio: s.image_ratio
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="custom-featured__empty">{{ 'custom.featured.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.custom-featured {
  --cf-cols: 3;
  background-color: var(--cf-bg, #000);
  color: var(--cf-fg, #fff);
  padding-block: var(--custom-space-2xl, 32px);
}
.custom-featured__head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--custom-space-md, 12px);
  margin-bottom: var(--custom-space-xl, 24px);
}
.custom-featured__heading {
  margin: 0;
}
.custom-featured__link {
  color: inherit;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: var(--custom-letter-spacing-labels, 1px);
  font-size: 0.875rem;
  white-space: nowrap;
}
.custom-featured__link:hover {
  color: var(--custom-color-accent, currentColor);
}
.custom-featured__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-lg, 16px);
}
.custom-featured__empty {
  opacity: 0.8;
}
@media screen and (min-width: 750px) {
  .custom-featured__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media screen and (min-width: 990px) {
  .custom-featured__grid {
    grid-template-columns: repeat(var(--cf-cols, 3), 1fr);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.featured.name",
  "tag": "section",
  "class": "custom-featured-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom.featured.heading",
      "default": "Inizia ad assaggiare questi"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:custom.featured.link_label",
      "default": "VAI ALLO SHOP"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:custom.featured.link_url"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:custom.featured.collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:custom.featured.products_count",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:custom.featured.columns",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:custom.featured.image_ratio",
      "options": [
        { "value": "square", "label": "t:custom.featured.ratio_square" },
        { "value": "portrait", "label": "t:custom.featured.ratio_portrait" },
        { "value": "landscape", "label": "t:custom.featured.ratio_landscape" },
        { "value": "natural", "label": "t:custom.featured.ratio_natural" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:custom.featured.show_price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "t:custom.featured.show_tagline",
      "info": "t:custom.featured.show_tagline_info",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:custom.featured.background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:custom.featured.text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:custom.featured.name"
    }
  ]
}
{% endschema %}
