{%- liquid
  assign s = section.settings
-%}
<section
  class="custom-categories"
  style="--cg-bg: {{ s.background_color | escape }}; --cg-fg: {{ s.text_color | escape }};"
>
  <div class="custom-container">
    {%- if s.heading != blank -%}
      <h2 class="custom-categories__heading custom-display">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="custom-categories__sub">{{ s.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="custom-categories__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="custom-categories__item" {{ block.shopify_attributes }}>
            <a class="custom-categories__card" href="{{ block.settings.link | default: '#' }}">
              <div class="custom-categories__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'custom-categories__img',
                      widths: '400, 600, 800',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      alt: block.settings.title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'custom-categories__placeholder' }}
                {%- endif -%}
                <span class="custom-categories__scrim" aria-hidden="true"></span>
              </div>
              <div class="custom-categories__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="custom-categories__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="custom-categories__cta">{{ block.settings.button_label | escape }} →</span>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.custom-categories {
  background-color: var(--cg-bg, #fff);
  color: var(--cg-fg, #252b37);
  padding-block: var(--custom-space-3xl, 48px);
}
.custom-categories__heading {
  margin: 0 0 var(--custom-space-sm, 8px);
  text-align: center;
  font-size: clamp(2rem, 4vw, 3rem);
}
.custom-categories__sub {
  margin: 0 auto var(--custom-space-2xl, 32px);
  max-width: 42rem;
  text-align: center;
  color: var(--custom-color-secondary, #535862);
  font-size: 1.125rem;
  line-height: 1.6;
}
.custom-categories__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--custom-space-lg, 16px);
}
.custom-categories__card {
  display: block;
  color: inherit;
  text-decoration: none;
  border-radius: var(--custom-radius-lg, 16px);
  overflow: hidden;
  border: 1px solid #e9eaeb;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.custom-categories__card:hover {
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
  transform: translateY(-2px);
}
.custom-categories__media {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
}
.custom-categories__img,
.custom-categories__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.custom-categories__scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgb(0 0 0 / 0.55));
}
.custom-categories__body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--custom-space-lg, 16px);
  color: #fff;
}
.custom-categories__item { position: relative; }
.custom-categories__title {
  margin: 0 0 6px;
  font-size: 1.25rem;
  font-weight: 600;
}
.custom-categories__cta {
  font-size: 0.875rem;
  font-weight: 500;
  opacity: 0.9;
}
@media screen and (min-width: 750px) {
  .custom-categories__grid { grid-template-columns: repeat(2, 1fr); }
}
@media screen and (min-width: 990px) {
  .custom-categories__grid { grid-template-columns: repeat(4, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "custom-categories-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find exactly what your operation needs from our comprehensive industrial catalog"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#252B37"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "Conveyor Components", "button_label": "Explore Category" } },
        { "type": "category", "settings": { "title": "Mechanical Power Transmission", "button_label": "Explore Category" } },
        { "type": "category", "settings": { "title": "Industrial Hose", "button_label": "Explore Category" } },
        { "type": "category", "settings": { "title": "Mechanical Components", "button_label": "Explore Category" } }
      ]
    }
  ]
}
{% endschema %}
