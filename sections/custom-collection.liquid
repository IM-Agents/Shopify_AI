{{ 'section-custom-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hero_description = collection.description
  if hero_description == blank
    assign hero_description = section.settings.fallback_description
  endif
-%}

<section class="custom-collection section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width custom-collection__page">
    <header class="custom-collection__hero">
      <h1 class="custom-collection__title">{{ collection.title | escape }}</h1>
      {%- if hero_description != blank -%}
        <div class="custom-collection__description rte">{{ hero_description }}</div>
      {%- endif -%}
    </header>

    <div class="custom-collection__layout">
      <aside class="custom-collection__sidebar small-hide" aria-label="{{ 'products.facets.filter_by_label' | t }}">
        {% render 'custom-collection-facets',
          results: collection,
          section: section,
          enable_filtering: section.settings.enable_filtering,
          form_id: 'FacetFiltersForm',
          wrapper_id: 'FacetsWrapperDesktop'
        %}
      </aside>

      <div class="custom-collection__main">
        {%- paginate collection.products by section.settings.products_per_page -%}
          <facet-filters-form class="custom-collection__toolbar-wrap">
            <form id="FacetSortForm" class="custom-collection__toolbar">
              <p class="custom-collection__count" role="status">
                <span id="ProductCount">
                  {%- if collection.products_count > 0 -%}
                    {%- if collection.products_count == collection.all_products_count -%}
                      {{ 'custom.collection.showing_count' | t: shown: collection.products.size, total: collection.products_count }}
                    {%- else -%}
                      {{ 'custom.collection.showing_count' | t: shown: collection.products.size, total: collection.products_count }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'custom.collection.showing_count' | t: shown: 0, total: 0 }}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </p>

              {%- if section.settings.enable_sorting -%}
                <div class="custom-collection__sort">
                  <label class="custom-collection__sort-label" for="SortBy">{{ 'custom.collection.sort_by' | t }}</label>
                  <div class="custom-collection__sort-select">
                    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                    <select
                      name="sort_by"
                      class="custom-collection__sort-input"
                      id="SortBy"
                      aria-describedby="a11y-refresh-page-message"
                    >
                      {%- for option in collection.sort_options -%}
                        <option
                          value="{{ option.value | escape }}"
                          {% if option.value == sort_by %}
                            selected="selected"
                          {% endif %}
                        >
                          {{ option.name | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                    <span class="custom-collection__sort-icon">
                      {{- 'custom-icon-chevron-down.svg' | inline_asset_content -}}
                    </span>
                  </div>
                </div>
              {%- endif -%}
            </form>
          </facet-filters-form>

          <div class="custom-collection__mobile-bar large-up-hide">
            {%- if section.settings.enable_filtering -%}
              <button
                type="button"
                class="custom-collection__mobile-filter-btn"
                aria-expanded="false"
                aria-controls="CustomCollectionMobileFilters"
                data-mobile-filter-open
              >
                {{ 'products.facets.filter_button' | t }}
              </button>
            {%- endif -%}
          </div>

          <div
            class="custom-collection__grid-wrap"
            id="ProductGridContainer"
          >
            {%- if collection.products.size == 0 -%}
              <div class="collection" data-id="{{ section.id }}">
                <div class="custom-collection__empty">
                  <p>{{ 'sections.collection_template.empty' | t }}</p>
                  <a href="{{ collection.url }}" class="custom-dr-btn custom-dr-btn--outline">
                    {{ 'products.facets.clear_all' | t }}
                  </a>
                </div>

                {%- if section.settings.show_demo_products -%}
                  <div id="product-grid" class="custom-collection__grid" data-id="{{ section.id }}" role="list">
                    {%- assign demo_blocks = section.blocks | where: 'type', 'demo_product' -%}
                    {%- if demo_blocks.size > 0 -%}
                      {%- for block in demo_blocks -%}
                        {%- assign figma_index = forloop.index | modulo: 8 -%}
                        {%- if figma_index == 0 -%}{%- assign figma_index = 8 -%}{%- endif -%}
                        {%- capture figma_default -%}{%- render 'custom-figma-asset', group: 'collection-product', index: figma_index -%}{%- endcapture -%}
                        {% render 'custom-collection-demo-card',
                          title: block.settings.title,
                          price: block.settings.price,
                          compare_price: block.settings.compare_price,
                          image: block.settings.image,
                          default_asset: figma_default | strip
                        %}
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..8) -%}
                        {%- capture figma_default -%}{%- render 'custom-figma-asset', group: 'collection-product', index: i -%}{%- endcapture -%}
                        {%- case i -%}
                          {%- when 1 -%}
                            {% render 'custom-collection-demo-card', title: 'Nature Inspired Dutch Marquise', price: '$1,021', compare_price: '$1,459', default_asset: figma_default | strip %}
                          {%- when 2 -%}
                            {% render 'custom-collection-demo-card', title: 'Vintage Marquise Cut Diamond', price: '$873', compare_price: '$1,248', default_asset: figma_default | strip %}
                          {%- when 3 -%}
                            {% render 'custom-collection-demo-card', title: 'Three Stone Marquise Ring', price: '$903', compare_price: '$1,291', default_asset: figma_default | strip %}
                          {%- when 4 -%}
                            {% render 'custom-collection-demo-card', title: 'Oval Hidden Halo Engagement Ring', price: '$404', compare_price: '$578', default_asset: figma_default | strip %}
                          {%- when 5 -%}
                            {% render 'custom-collection-demo-card', title: 'Dutch Marquise Solitaire', price: '$944', compare_price: '$1,349', default_asset: figma_default | strip %}
                          {%- when 6 -%}
                            {% render 'custom-collection-demo-card', title: 'Oval Halo Engagement Ring', price: '$900', compare_price: '$1,286', default_asset: figma_default | strip %}
                          {%- when 7 -%}
                            {% render 'custom-collection-demo-card', title: '2.25 TW Pear Cut Ring', price: '$1,705', compare_price: '$2,436', default_asset: figma_default | strip %}
                          {%- when 8 -%}
                            {% render 'custom-collection-demo-card', title: 'Fancy Blue Pear Cut Ring', price: '$1,267', compare_price: '$1,811', default_asset: figma_default | strip %}
                        {%- endcase -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="collection" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div id="product-grid" class="custom-collection__grid" data-id="{{ section.id }}" role="list">
                  {%- for product in collection.products -%}
                    {%- assign figma_index = forloop.index | modulo: 8 -%}
                    {%- if figma_index == 0 -%}{%- assign figma_index = 8 -%}{%- endif -%}
                    {%- capture figma_default -%}{%- render 'custom-figma-asset', group: 'collection-product', index: figma_index -%}{%- endcapture -%}
                    {% render 'custom-collection-card',
                      product: product,
                      default_asset: figma_default | strip
                    %}
                  {%- endfor -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  <div class="custom-collection__load-more">
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}" class="custom-collection__load-more-btn">
                        {{ 'custom.collection.load_more' | t }}
                      </a>
                    {%- else -%}
                      <span class="custom-collection__load-more-btn custom-collection__load-more-btn--disabled" aria-disabled="true">
                        {{ 'custom.collection.load_more' | t }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endpaginate -%}
      </div>
    </div>
  </div>

  {%- if section.settings.enable_filtering -%}
    <div id="CustomCollectionMobileFilters" class="custom-collection__mobile-drawer large-up-hide" hidden>
      <div class="custom-collection__mobile-drawer-header">
        <h2 class="custom-collection__mobile-drawer-title">{{ 'products.facets.filter_by_label' | t }}</h2>
        <button type="button" class="custom-collection__mobile-drawer-close" data-mobile-filter-close aria-label="{{ 'accessibility.close' | t }}">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      {% render 'custom-collection-facets',
        results: collection,
        section: section,
        enable_filtering: true,
        form_id: 'FacetFiltersFormMobile',
        wrapper_id: 'FacetsWrapperMobile',
        details_id_prefix: 'Mobile-',
        facet_id_prefix: 'FacetMobile-',
        input_id_prefix: 'Mobile-Filter-'
      %}
    </div>
    <div class="custom-collection__mobile-overlay" data-mobile-filter-close hidden></div>
  {%- endif -%}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const openBtn = document.querySelector('[data-mobile-filter-open]');
    const closeBtns = document.querySelectorAll('[data-mobile-filter-close]');
    const drawer = document.getElementById('CustomCollectionMobileFilters');
    const overlay = document.querySelector('.custom-collection__mobile-overlay');
    const mobileFilterForm = document.getElementById('FacetFiltersFormMobile');

    if (!openBtn || !drawer) return;

    function closeDrawer() {
      drawer.setAttribute('hidden', '');
      overlay?.setAttribute('hidden', '');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    }

    openBtn.addEventListener('click', function () {
      drawer.removeAttribute('hidden');
      overlay?.removeAttribute('hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
    });

    closeBtns.forEach(function (btn) {
      btn.addEventListener('click', closeDrawer);
    });

    if (mobileFilterForm) {
      mobileFilterForm.addEventListener('change', function () {
        window.setTimeout(closeDrawer, 900);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Collection",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "Rings made for forever moments. Discover our collection of meticulously crafted engagement rings."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "show_demo_products",
      "default": true,
      "label": "Show demo products when collection is empty"
    }
  ],
  "blocks": [
    {
      "type": "demo_product",
      "name": "Demo product",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Nature Inspired Dutch Marquise"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$1,021"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at price",
          "default": "$1,459"
        }
      ]
    },
    {
      "type": "filter_group",
      "name": "Filter group",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Ring Style"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options (comma separated)",
          "default": "Solitaire, Halo, Three Stone, Vintage"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection",
      "blocks": [
        {
          "type": "filter_group",
          "settings": {
            "title": "Ring Style",
            "options": "Solitaire, Halo, Three Stone, Vintage"
          }
        },
        {
          "type": "filter_group",
          "settings": {
            "title": "Diamond Shape",
            "options": "Round, Oval, Emerald, Marquise"
          }
        },
        {
          "type": "filter_group",
          "settings": {
            "title": "Metal",
            "options": "14k Yellow Gold, 14k White Gold, 14k Rose Gold, Platinum"
          }
        }
      ]
    }
  ]
}
{% endschema %}
