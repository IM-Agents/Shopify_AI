{%- liquid
  assign s = section.settings
  assign has_content = false
  if s.eyebrow != blank or s.heading != blank or s.subtext != blank or s.button_label != blank or s.button_2_label != blank
    assign has_content = true
  endif
-%}
<section
  class="custom-hero custom-hero--align-{{ s.content_alignment }} custom-hero--pos-{{ s.content_position }}{% unless s.full_width %} custom-hero--contained{% endunless %}"
  style="--hero-max-w: {{ s.image_max_width | escape }}px; --hero-min-h: {{ s.min_height | escape }}px; --hero-overlay: {{ s.overlay_opacity | escape }}; --hero-content-color: {{ s.content_color | escape }};"
  data-custom-hero
>
  <div class="custom-hero__frame">
    {%- if s.background_image != blank -%}
      <div class="custom-hero__bg" aria-hidden="true">
        {{
          s.background_image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            class: 'custom-hero__bg-img',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '100vw',
            alt: ''
        }}
      </div>
    {%- endif -%}

    <div class="custom-hero__media">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            class: 'custom-hero__img custom-hero__img--desktop',
            widths: '600, 900, 1200, 1400, 1600',
            sizes: '(min-width: 990px) 1300px, 100vw',
            alt: s.image.alt | default: shop.name
        }}
        {%- if s.image_mobile != blank -%}
          {{
            s.image_mobile
            | image_url: width: 900
            | image_tag:
              loading: 'eager',
              class: 'custom-hero__img custom-hero__img--mobile',
              widths: '400, 600, 750, 900',
              sizes: '100vw',
              alt: s.image_mobile.alt | default: shop.name
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-hero__img custom-hero__placeholder' }}
      {%- endif -%}

      {%- if s.show_overlay -%}
        <span class="custom-hero__scrim" aria-hidden="true"></span>
      {%- endif -%}

      {%- if has_content -%}
        <div class="custom-hero__content custom-container">
          <div class="custom-hero__content-inner">
            {%- if s.eyebrow != blank -%}
              <p class="custom-hero__eyebrow custom-eyebrow">{{ s.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if s.heading != blank -%}
              <h2 class="custom-hero__heading custom-display">{{ s.heading | escape }}</h2>
            {%- endif -%}
            {%- if s.subtext != blank -%}
              <div class="custom-hero__subtext rte">{{ s.subtext }}</div>
            {%- endif -%}
            {%- if s.button_label != blank or s.button_2_label != blank -%}
              <div class="custom-hero__ctas">
                {%- if s.button_label != blank -%}
                  <a class="custom-btn custom-btn--primary" {% if s.button_link != blank %}href="{{ s.button_link }}"{% else %}href="#" aria-disabled="true"{% endif %}>{{ s.button_label | escape }}</a>
                {%- endif -%}
                {%- if s.button_2_label != blank -%}
                  <a class="custom-btn custom-btn--secondary" {% if s.button_2_link != blank %}href="{{ s.button_2_link }}"{% else %}href="#" aria-disabled="true"{% endif %}>{{ s.button_2_label | escape }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if s.decorative_band != blank -%}
      <div class="custom-hero__band" aria-hidden="true">
        {{
          s.decorative_band
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            class: 'custom-hero__band-img',
            widths: '750, 1100, 1500, 2000',
            sizes: '100vw',
            alt: ''
        }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.custom-hero {
  --hero-overlay: 0;
  position: relative;
}
.custom-hero--contained .custom-hero__frame {
  max-width: var(--hero-max-w, 1300px);
  margin-inline: auto;
}
.custom-hero__frame {
  position: relative;
}
.custom-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.custom-hero__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.custom-hero__media {
  position: relative;
  z-index: 1;
  min-height: var(--hero-min-h, 0);
  display: grid;
}
.custom-hero__media > * {
  grid-area: 1 / 1;
}
.custom-hero__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.custom-hero__placeholder {
  background: rgb(var(--color-foreground, 18 18 18) / 0.06);
}
.custom-hero__scrim {
  background: rgb(0 0 0 / var(--hero-overlay, 0));
}
.custom-hero__band {
  position: relative;
  z-index: 2;
  line-height: 0;
}
.custom-hero__band-img {
  width: 100%;
  height: auto;
  display: block;
}

/* Art-directed mobile/desktop swap */
.custom-hero__img--mobile {
  display: none;
}
@media screen and (max-width: 749px) {
  .custom-hero__img--desktop {
    display: none;
  }
  .custom-hero__media:has(.custom-hero__img--mobile) .custom-hero__img--mobile {
    display: block;
  }
}

/* Overlay content */
.custom-hero__content {
  position: relative;
  z-index: 2;
  display: flex;
  width: 100%;
  padding-block: var(--custom-space-xl, 24px);
}
.custom-hero__content-inner {
  max-width: 46rem;
  color: var(--hero-content-color, #fff);
  display: flex;
  flex-direction: column;
  gap: var(--custom-space-md, 12px);
}
.custom-hero__heading {
  color: inherit;
}
.custom-hero__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: var(--custom-space-sm, 8px);
  margin-top: var(--custom-space-xs, 6px);
}

.custom-hero--align-center .custom-hero__content { justify-content: center; }
.custom-hero--align-center .custom-hero__content-inner { text-align: center; align-items: center; }
.custom-hero--align-right .custom-hero__content { justify-content: flex-end; }
.custom-hero--align-right .custom-hero__content-inner { text-align: right; align-items: flex-end; }
.custom-hero--align-left .custom-hero__content { justify-content: flex-start; }

.custom-hero--pos-top .custom-hero__content { align-items: flex-start; }
.custom-hero--pos-middle .custom-hero__content { align-items: center; }
.custom-hero--pos-bottom .custom-hero__content { align-items: flex-end; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom.hero.name",
  "tag": "section",
  "class": "custom-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "t:custom.hero.images.header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:custom.hero.images.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:custom.hero.images.image_mobile",
      "info": "t:custom.hero.images.image_mobile_info"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:custom.hero.images.background_image"
    },
    {
      "type": "image_picker",
      "id": "decorative_band",
      "label": "t:custom.hero.images.decorative_band",
      "info": "t:custom.hero.images.decorative_band_info"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "t:custom.hero.images.max_width",
      "default": 1300
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:custom.hero.images.full_width",
      "default": false
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "t:custom.hero.images.min_height",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:custom.hero.content.header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:custom.hero.content.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom.hero.content.heading"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "t:custom.hero.content.subtext"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "t:custom.hero.content.content_color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:custom.hero.content.alignment",
      "options": [
        { "value": "left", "label": "t:custom.hero.content.align_left" },
        { "value": "center", "label": "t:custom.hero.content.align_center" },
        { "value": "right", "label": "t:custom.hero.content.align_right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:custom.hero.content.position",
      "options": [
        { "value": "top", "label": "t:custom.hero.content.pos_top" },
        { "value": "middle", "label": "t:custom.hero.content.pos_middle" },
        { "value": "bottom", "label": "t:custom.hero.content.pos_bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:custom.hero.content.show_overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 0.8,
      "step": 0.1,
      "label": "t:custom.hero.content.overlay_opacity",
      "default": 0.3
    },
    {
      "type": "header",
      "content": "t:custom.hero.buttons.header"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:custom.hero.buttons.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:custom.hero.buttons.button_link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "t:custom.hero.buttons.button_2_label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "t:custom.hero.buttons.button_2_link"
    }
  ],
  "presets": [
    {
      "name": "t:custom.hero.name"
    }
  ]
}
{% endschema %}
